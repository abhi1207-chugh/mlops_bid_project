# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- LLM provider (behind services/common/llm.py) ---
# Provider name understood by LLMClient, e.g. gemini | stub
LLM_PROVIDER=stub
# Provider API key (leave empty for stub)
LLM_API_KEY=
# Provider base URL (for the stub service use the in-compose address)
LLM_BASE_URL=http://stub-llm:8080
# Model identifier supplied by you at runtime
LLM_MODEL=
# Price per 1K tokens, used for cost tracking (L5)
LLM_PRICE_PROMPT_PER_1K=0
LLM_PRICE_COMPLETION_PER_1K=0
# Timeouts and retry
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# --- Stub LLM (load tests) ---
STUB_DELAY_MS=1500

# --- Agent loop limits (A1) ---
AGENT_MAX_STEPS=16
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_SECONDS=120

# --- Embeddings and index ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEX_DIR=/data/index
CORPUS_DIR=/app/corpus

# --- Infrastructure ---
REDIS_URL=redis://redis:6379/0
QUARANTINE_DIR=/data/quarantine
RUN_STORE_DIR=/data/runs
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- Rate limiting (D7) ---
RATE_LIMIT_PER_MINUTE=10

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Host port for the API (change if 8000 is taken) ---
API_PORT=8000
GRAFANA_PORT=3000
